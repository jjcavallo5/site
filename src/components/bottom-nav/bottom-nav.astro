---
import "@/styles/global.css";
import BottomNavLeftIcon from "./bottom-nav-left-icon.astro";
import RightArrow from "./right-arrow.astro";
import BottomNavRoute from "./bottom-nav-route.astro";
import BottomNavDate from "./bottom-nav-date.astro";
---

<nav class="mb-4 flex flex-row items-start h-[32px]">
  <BottomNavLeftIcon />
  <RightArrow className="border-l-green" />
  <BottomNavRoute
    name="home"
    href="/"
    index={1}
    icon="nf-seti-home"
    isActive={!Astro.url.pathname.startsWith("/blog") &&
      !Astro.url.pathname.startsWith("/projects")}
  />
  <BottomNavRoute
    name="blog"
    href="/blog"
    index={2}
    icon="nf-fa-pencil_square_o"
    isActive={Astro.url.pathname.startsWith("/blog")}
  />
  <BottomNavRoute
    name="projects"
    href="/projects"
    index={3}
    icon="nf-oct-workflow"
    isActive={Astro.url.pathname.startsWith("/projects")}
  />
  <div class="flex-1"></div>
  <BottomNavDate className="hidden lg:flex" />
</nav>

<script>
  import { navigate } from "astro:transitions/client";

  window.addEventListener("keydown", (e) => {
    const isMac = navigator.platform.toUpperCase().includes("MAC");
    const modifier = isMac ? e.metaKey : e.altKey;

    if (!modifier) return;

    switch (e.key) {
      case "1":
        e.preventDefault();
        navigate("/");
        break;
      case "2":
        e.preventDefault();
        navigate("/blog");
        break;
      case "3":
        e.preventDefault();
        navigate("/projects");
        break;
    }
  });
</script>
