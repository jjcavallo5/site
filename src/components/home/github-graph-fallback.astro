---
import GithubCalendarDay from "./github-calendar-day.astro";
---

<div class="mt-4">
  <p class="text-fg-muted mb-2">Loading contributions...</p>
  <div class="relative">
    <div class="flex flex-row overflow-x-auto">
      {
        Array.from({ length: 53 }).map(() => (
          <div class="flex flex-col gap-[4px] w-[20px]">
            {Array.from({ length: 7 }).map(() => (
              <GithubCalendarDay
                contributionCount={0}
                contributionLevel="NONE"
                color="#fff"
                date="Jan 01"
                weekday={0}
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</div>
