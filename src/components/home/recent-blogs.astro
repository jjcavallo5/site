---
import { getCollection } from "astro:content";
import { formatDate } from "@/lib/utils";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<ul>
  {
    posts.map((post, idx) => (
      <li class="flex flex-row justify-between items-center group my-4 gap-2">
        <a href={`/blog/${post.id}`} class="flex flex-col">
          <h4
            class="text-lg text-fg group-hover:text-purple ease-in-out transition duration-500"
            transition:name="blog-title"
          >
            {post.data.title}
          </h4>
          <p class="text-md text-fg-muted group-hover:text-fg ease-in-out transition duration-500">
            {formatDate(post.data.pubDate)} &bull; {post.data.description}
          </p>
        </a>
        <p class="italic text-purple">b{idx}</p>
      </li>
    ))
  }
</ul>
