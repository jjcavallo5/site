---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getEntry, render } from "astro:content";
import { getImage } from "astro:assets";

const { id } = Astro.params;
const post = await getEntry("blog", id!);

if (!post) {
  return Astro.redirect("/404");
}

const { Content } = await render(post);

const ogImage = post.data.coverImage
  ? (await getImage({ src: post.data.coverImage, width: 1200 })).src
  : undefined;
---

<BlogLayout
  title={post.data.title}
  published={post.data.pubDate}
  author={post.data.author}
  description={post.data.description}
  ogImage={ogImage}
>
  <Content />
</BlogLayout>

<script
  is:inline
  define:vars={{
    postId: post.id,
    postTitle: post.data.title,
    postAuthor: post.data.author,
  }}
>
  function trackBlogView() {
    window.posthog?.capture("blog_post_viewed", {
      post_id: postId,
      post_title: postTitle,
      post_author: postAuthor,
    });
  }

  document.addEventListener("DOMContentLoaded", trackBlogView);
  document.addEventListener("astro:page-load", trackBlogView);
</script>
